{
    "buildCommand": "echo no-op",
    "outputDirectory": "public",
    "regions": [
        "bom1"
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily",
            "schedule": "30 3 * * *"
        }
    ]
}
