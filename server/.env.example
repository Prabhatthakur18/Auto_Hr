DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=24h

# SMTP (for email) — e.g. Gmail: host smtp.gmail.com, port 587, user/pass = an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Salary / Payroll Integration
SALARY_API_KEY=your_secure_random_api_key_here
SALARY_ENCRYPTION_KEY=your_secure_32_character_encryption_key_here
