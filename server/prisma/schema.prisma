generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique @db.VarChar(50)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  role           Role           @default(EMPLOYEE)
  employeeId     Int?           @unique @map("employee_id")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  announcements  Announcement[]
  approvedLeaves Leave[]        @relation("ApprovedBy")
  employee       Employee?      @relation(fields: [employeeId], references: [id])

  @@map("users")
}

model Employee {
  id               Int               @id @default(autoincrement())
  biometricId      Int?              @unique @map("biometric_id")
  name             String            @db.VarChar(100)
  position         String?           @db.VarChar(100)
  department       String?           @db.VarChar(100)
  email            String?           @unique @db.VarChar(100)
  phone            String?           @db.VarChar(20)
  joinDate         DateTime?         @map("join_date") @db.Date
  managerId        Int?              @map("manager_id")
  avatar           String?           @db.VarChar(500)
  bio              String?           @db.Text
  skills           String?           @db.LongText
  experience       String?           @db.Text
  education        String?           @db.VarChar(255)
  employeeType     String?           @map("employee_type") @db.VarChar(50)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  attendance       Attendance[]
  manager          Employee?         @relation("ManagerReports", fields: [managerId], references: [id])
  directReports    Employee[]        @relation("ManagerReports")
  kras             Kra[]
  leaves           Leave[]
  salaryBreakdowns SalaryBreakdown[]
  salarySlips      SalarySlip[]
  user             User?

  @@index([managerId], map: "employees_manager_id_fkey")
  @@map("employees")
}

model Attendance {
  id                Int              @id @default(autoincrement())
  employeeId        Int              @map("employee_id")
  date              DateTime         @db.Date
  day               String?          @db.VarChar(10)
  checkIn           String?          @map("check_in") @db.VarChar(10)
  checkOut          String?          @map("check_out") @db.VarChar(10)
  totalWorkingHours String?          @map("total_working_hours") @db.VarChar(10)
  isLate            Boolean          @default(false) @map("is_late")
  lateBy            String?          @map("late_by") @db.VarChar(30)
  overtime          Boolean          @default(false)
  otTime            String?          @map("ot_time") @db.VarChar(10)
  status            AttendanceStatus @default(PRESENT)
  createdAt         DateTime         @default(now()) @map("created_at")
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance")
}

model Leave {
  id           Int         @id @default(autoincrement())
  employeeId   Int         @map("employee_id")
  type         String      @db.VarChar(50)
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime    @map("end_date") @db.Date
  days         Int
  status       LeaveStatus @default(PENDING)
  reason       String?     @db.Text
  approvedById Int?        @map("approved_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  approvedBy   User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approverIds  String?     @map("approver_ids") @db.VarChar(500)
  comment      String?     @db.Text

  @@index([approvedById], map: "leaves_approved_by_id_fkey")
  @@index([employeeId], map: "leaves_employee_id_fkey")
  @@map("leaves")
}

model SalaryBreakdown {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @map("employee_id")
  basicSalary      Decimal  @default(0.00) @map("basic_salary") @db.Decimal(10, 2)
  hra              Decimal  @default(0.00) @db.Decimal(10, 2)
  da               Decimal  @default(0.00) @db.Decimal(10, 2)
  ta               Decimal  @default(0.00) @db.Decimal(10, 2)
  medicalAllowance Decimal  @default(0.00) @map("medical_allowance") @db.Decimal(10, 2)
  specialAllowance Decimal  @default(0.00) @map("special_allowance") @db.Decimal(10, 2)
  pf               Decimal  @default(0.00) @db.Decimal(10, 2)
  esi              Decimal  @default(0.00) @db.Decimal(10, 2)
  tax              Decimal  @default(0.00) @db.Decimal(10, 2)
  otherDeductions  Decimal  @default(0.00) @map("other_deductions") @db.Decimal(10, 2)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "salary_breakdowns_employee_id_fkey")
  @@map("salary_breakdowns")
}

model SalarySlip {
  id              Int      @id @default(autoincrement())
  employeeId      Int      @map("employee_id")
  month           String   @db.VarChar(7)
  grossSalary     Decimal  @map("gross_salary") @db.Decimal(10, 2)
  totalDeductions Decimal  @map("total_deductions") @db.Decimal(10, 2)
  netSalary       Decimal  @map("net_salary") @db.Decimal(10, 2)
  workingDays     Int      @map("working_days")
  daysPresent     Int      @map("days_present")
  breakdownJson   String?  @map("breakdown_json") @db.LongText
  generatedAt     DateTime @default(now()) @map("generated_at")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@map("salary_slips")
}

model Announcement {
  id            Int                  @id @default(autoincrement())
  title         String               @db.VarChar(255)
  content       String?              @db.Text
  priority      AnnouncementPriority @default(LOW)
  attachmentUrl String?              @map("attachment_url") @db.VarChar(500)
  createdById   Int                  @map("created_by_id")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  expiresAt     DateTime?            @map("expires_at")
  createdBy     User                 @relation(fields: [createdById], references: [id])

  @@index([createdById], map: "announcements_created_by_id_fkey")
  @@map("announcements")
}

model Kra {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  title       String   @db.VarChar(200)
  description String?  @db.Text
  period      String   @default("Ongoing") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  kpis        Kpi[]
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "kras_employee_id_fkey")
  @@map("kras")
}

model Kpi {
  id        Int      @id @default(autoincrement())
  kraId     Int      @map("kra_id")
  metric    String   @db.VarChar(200)
  target    Decimal  @db.Decimal(10, 2)
  actual    Decimal? @db.Decimal(10, 2)
  unit      String?  @db.VarChar(50)
  score     Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  kra       Kra      @relation(fields: [kraId], references: [id], onDelete: Cascade)

  @@index([kraId], map: "kpis_kra_id_fkey")
  @@map("kpis")
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
